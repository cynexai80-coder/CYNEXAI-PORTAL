GROQ_API_KEY=your_groq_api_key_here

# Browser app (set the real values in the Netlify site environment; never commit them).
# Leave the Turso pair EMPTY locally unless you point it at a local/test database.
VITE_TURSO_DATABASE_URL=
VITE_TURSO_AUTH_TOKEN=
# Base URL of the WhatsApp service (backend/server.js on Render), e.g. https://your-service.onrender.com
# Empty in production = the WhatsApp screen shows "offline". In `vite dev` it falls back to http://localhost:5000.
VITE_WHATSAPP_API_URL=

# Optional: only for the one-off maintenance scripts in scripts/ and root
DEV_TURSO_AUTH_TOKEN=
VIRINCHI_TURSO_AUTH_TOKEN=
